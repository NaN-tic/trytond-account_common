msgid ""
msgstr "Content-Type: text/plain; charset=utf-8\n"

msgctxt "field:account.invoice.pay.start,multiple:"
msgid "Multiple Invoices"
msgstr "Múltiples factures"

msgctxt "field:account.invoice.pay.start,invoices:"
msgid "Invoices"
msgstr "Factures"

msgctxt "model:ir.message,text:msg_undo_pay_mixed"
msgid "Invoice \"%(invoice)s\" also has payments that this action cannot undo. Only individual payments originating from this invoice will be removed. To undo the other payments, manually unreconcile the corresponding lines and reverse these moves: %(moves)s."
msgstr "La factura \"%(invoice)s\" també té pagaments que aquesta acció no pot desfer. Només s'eliminaran els pagaments individuals amb origen en aquesta factura. Per desfer els altres pagaments, desconcilia manualment les línies corresponents i reverteix aquests assentaments: %(moves)s."

msgctxt "model:ir.message,text:msg_multiple_payment_invoices"
msgid "Select posted invoices with an outstanding balance for the same party, company, currency and invoice type, without alternative payees."
msgstr "Selecciona factures comptabilitzades amb saldo pendent del mateix tercer, empresa, moneda i tipus de factura, sense beneficiaris alternatius."

msgctxt "model:ir.message,text:msg_multiple_payment_changed"
msgid "The outstanding balances cannot be paid in full with the displayed payment details. Reopen the payment wizard and review the invoices and their existing payments."
msgstr "No es poden pagar íntegrament els saldos pendents amb les dades de pagament mostrades. Torna a obrir l'assistent de pagament i revisa les factures i els pagaments existents."

msgctxt "model:ir.message,text:msg_multiple_payment_method"
msgid "Select a payment method for the invoices' company whose accounts differ from all the invoice accounts."
msgstr "Selecciona un mètode de pagament de l'empresa de les factures amb comptes diferents de tots els comptes de les factures."

msgctxt "field:account.invoice,paid_directly:"
msgid "Has Payed directly"
msgstr "Ha pagat directament"

msgctxt "field:account.move,allow_button_draft:"
msgid "Allow Button Draft Move"
msgstr "Permetre botó Esborrany"

msgctxt "field:account.move,allow_draft:"
msgid "Allow Draft Move"
msgstr "Permetre assentament en esborrany"

msgctxt "field:account.period,code:"
msgid "Code"
msgstr "Codi"

msgctxt "field:party.configuration,tax_identifier_types:"
msgid "Additional Tax Identifier Types"
msgstr "Tipus addicionals d’identificador fiscal"

msgctxt "help:account.invoice,paid_directly:"
msgid "The invoice has payed with the 'PAY' button"
msgstr "La factura s'ha pagat amb el botó \"PAGAR\""

msgctxt "help:party.configuration,tax_identifier_types:"
msgid ""
"Defines extra identifier types that are considered fiscal.\n"
"The standard fiscal identifier types from Party are always included."
msgstr ""
"Defineix tipus addicionals d’identificador que es consideren fiscals.\n"
"Els tipus estàndard d’identificador fiscal de Tercers sempre s’inclouen."

msgctxt "model:ir.message,text:msg_cancel_invoice_with_group_permission"
msgid "You do not have permission to cancel invoices."
msgstr "No teniu permisos per cancel·lar factures."

msgctxt "model:ir.message,text:msg_cancel_invoice_with_move_post"
msgid "You cannot cancel an invoice with a posted move."
msgstr "No es pot cancel·lar una factura amb un assentament comptabilitzat."

msgctxt "model:ir.message,text:msg_cancel_move_with_origin"
msgid ""
"The move \"%(move)s\" colud not be cancelled because came from origin "
"\"%(origin)s\". To cancel it has to be done througth the origin."
msgstr ""
"L'assentament \"%(move)s\" no pot ser cancel·lat perquè té un origen "
"\"%(origin)s\". Per cancel·lar-lo cal fer-ho des de l'origen."

msgctxt "model:ir.model.button,confirm:invoice_undo_pay_button"
msgid ""
"This action will remove all the payments done directly to the invoice from "
"the PAY button. Are you sure you want to continue?"
msgstr ""
"Aquesta acció eliminarà tots els pagaments fets directament a la factura a través "
"del botó PAGAR. Esteu segur que voleu continuar?"

msgctxt "model:ir.model.button,string:invoice_undo_pay_button"
msgid "Undo Payment"
msgstr "Desfer el pagament"

msgctxt "model:ir.model.button,string:move_draft_button"
msgid "Draft"
msgstr "Esborrany"

msgctxt "model:res.group,name:group_invoice_cancel"
msgid "Cancel Invoices"
msgstr "Cancel·lar factures"
